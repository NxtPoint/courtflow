# Local / build artefacts
# .claude/ is ignored EXCEPT skills/ — the skills are shared team assets (the marketing-manager and
# tennis-reel operators) and must be version-controlled + backed up. settings.local.json stays ignored:
# it holds this machine's permission grants. Note `.claude/*` not `.claude/`, because git cannot
# re-include anything inside a directory that is itself excluded.
.claude/*
!.claude/skills/
.venv/
.venv-*/
__pycache__/
*.pyc
.env
.env.*
node_modules/
.DS_Store
*.egg-info/
.pytest_cache/
migration/url_inventory.csv

# Local-only ad-ops notes (NOT platform code). The LEADING SLASH anchors this to the repo root on
# purpose: a bare `marketing/` would also match the tracked public site at frontend/marketing/, so a
# new page added there would be silently ignored. Does not affect marketing_crm/ or marketing_digest/.
/marketing/
